# sidescroll ghostty config
# dankcolors is generated by DankMaterialShell into ~/.config/ghostty/themes/;
# a missing-theme warning before DMS first applies terminal theming is harmless.

font-family = Maple Mono
font-size = 11.5

theme = dankcolors

background-opacity = 0.92
# no-op on 1.3.1 (Linux blur needs ghostty 1.4); the niri window-rule blurs instead
background-blur = true

window-padding-x = 8
window-padding-y = 8
gtk-titlebar = false
gtk-single-instance = true
