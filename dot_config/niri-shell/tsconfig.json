{
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "jsxImportSource": "astal/gtk4",
        "baseUrl": ".",
        "paths": {
            "astal": ["/usr/share/astal/gjs"],
            "astal/*": ["/usr/share/astal/gjs/*"]
        }
    }
}
