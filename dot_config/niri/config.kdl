// sidescroll: niri + DankMaterialShell
// Hand-written. DMS-generated files live in ./dms/ and are included below:
// binds.kdl is included BEFORE the binds block so this file's binds win;
// colors/layout/alttab are included at the end so DMS's generated values win.

input {
    keyboard {
        xkb {
        }
    }
    touchpad {
        tap
        dwt
        accel-speed 0.5
    }
    focus-follows-mouse max-scroll-amount="0%"
}

output "eDP-1" {
    scale 1.0
    // variable-refresh-rate on-demand=true
}

include optional=true "dms/binds.kdl"

layout {
    gaps 12
    center-focused-column "never"
    background-color "transparent"

    // PaperWM-style edge peek: keep a sliver of the adjacent off-screen column
    // visible at each screen edge; clicking a sliver slides that column in.
    // (Upstream niri-wm/niri PR #4069 "edge-overscroll" is the future native
    // hover version; focus-follows-mouse max-scroll-amount governs hover.)
    struts {
        left 32
        right 32
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        on
        width 2
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        draw-behind-window true
        color "#00000070"
    }

    tab-indicator {
        position "top"
        width 4
        gap 4
        corner-radius 4
        gaps-between-tabs 4
        length total-proportion=0.5
        place-within-column
    }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

blur {
    passes 2
    offset 3
    noise 0.02
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id="xdg-desktop-portal-gtk"
    open-floating true
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

layer-rule {
    match namespace="dms:blurwallpaper"
    place-within-backdrop true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return { spawn "ptyxis" "--new-window"; }
    Mod+D { spawn "fuzzel" "--config" "/var/home/ashahid/.config/fuzzel/niri.ini"; }
    Mod+Space { spawn "fuzzel" "--config" "/var/home/ashahid/.config/fuzzel/niri.ini"; }
    Mod+N { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Semicolon repeat=false { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Alt+V repeat=false { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Escape allow-when-locked=true { spawn "dms" "ipc" "call" "lock" "lockAndOutputsOff"; }

    XF86AudioRaiseVolume allow-when-locked=true allow-inhibiting=false { spawn "/var/home/ashahid/.local/bin/niri-osd" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true allow-inhibiting=false { spawn "/var/home/ashahid/.local/bin/niri-osd" "volume-down"; }
    XF86AudioMute allow-when-locked=true allow-inhibiting=false { spawn "/var/home/ashahid/.local/bin/niri-osd" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true allow-inhibiting=false { spawn "/var/home/ashahid/.local/bin/niri-osd" "mic-mute"; }
    XF86MonBrightnessUp allow-when-locked=true allow-inhibiting=false { spawn "/var/home/ashahid/.local/bin/niri-osd" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true allow-inhibiting=false { spawn "/var/home/ashahid/.local/bin/niri-osd" "brightness-down"; }
    XF86AudioPlay allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioNext allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "previous"; }

    Mod+Q { close-window; }
    Mod+O repeat=false { toggle-overview; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }

    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Shift+U { move-column-to-workspace-down; }
    Mod+Shift+I { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Print { screenshot; }
    Mod+Shift+S { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
    Ctrl+Alt+Delete { quit; }
}

include optional=true "dms/colors.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/alttab.kdl"
