#!/usr/bin/env bash
# Lock the niri session. DMS must stay the ONLY ext-session-lock client when
# it is running (hyprlock racing it froze unlocks, 2026-07-25); hyprlock/
# swaylock are fallbacks for a DMS-less session only.
set -uo pipefail

if command -v dms >/dev/null 2>&1; then
    # DMS installed = DMS is the only allowed lock client, even if its IPC is
    # briefly down (mid-restart). Fail loudly rather than racing it with a
    # second ext-session-lock client (2026-07-25 freeze).
    exec dms ipc call lock lock
elif command -v hyprlock >/dev/null 2>&1; then
    pidof hyprlock >/dev/null || exec hyprlock
else
    exec swaylock -f \
        --color 11111b \
        --indicator-radius 90 \
        --indicator-thickness 8 \
        --inside-color 1e1e2e \
        --inside-clear-color 313244 \
        --inside-ver-color 313244 \
        --inside-wrong-color 313244 \
        --ring-color cba6f7 \
        --ring-clear-color f9e2af \
        --ring-ver-color 89b4fa \
        --ring-wrong-color f38ba8 \
        --key-hl-color 89b4fa \
        --bs-hl-color f38ba8 \
        --text-color cdd6f4 \
        --text-clear-color cdd6f4 \
        --text-ver-color cdd6f4 \
        --text-wrong-color f38ba8 \
        --line-color 00000000 \
        --separator-color 00000000
fi
