#!/usr/bin/env bash
# Volume/brightness keys for the niri session. DMS renders its own volume,
# microphone, and brightness OSDs (it watches PipeWire and brightness state
# directly) and plays its own volume sound, so while DMS is up this script
# only mutates state. The notification + chime below are fallbacks for
# sessions without DMS (quickshell's binary is `qs`).
set -uo pipefail

dms_up() {
    # Unit check, not pgrep: on NixOS the quickshell process's comm is the
    # Qt-wrapper name (".quickshell-wra"), and a process-name match would
    # also false-positive on non-DMS quickshell instances.
    systemctl --user is-active --quiet dms.service 2>/dev/null
}

osd() { # title, percent, icon
    dms_up && return 0
    notify-send -e -a "niri-osd" -u low -t 2000 \
        -h string:x-canonical-private-synchronous:niri-osd \
        -h string:x-dunst-stack-tag:niri-osd \
        -h "int:value:$2" \
        -i "$3" "$1"
}

volume_feedback() {
    dms_up && return 0
    # Match GNOME's volume-key feedback event. It is played after wpctl changes
    # the sink, so the chime itself demonstrates the newly selected volume.
    if command -v canberra-gtk-play >/dev/null 2>&1; then
        canberra-gtk-play \
            --id=audio-volume-change \
            --description="Volume changed" \
            >/dev/null 2>&1 &
    elif command -v pw-play >/dev/null 2>&1 &&
         [ -r /usr/share/sounds/freedesktop/stereo/audio-volume-change.oga ]; then
        pw-play /usr/share/sounds/freedesktop/stereo/audio-volume-change.oga \
            >/dev/null 2>&1 &
    fi
}

vol() {
    wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}'
}

muted() {
    wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED
}

vol_icon() {
    if muted; then
        echo audio-volume-muted-symbolic
    elif [ "$1" -ge 60 ]; then
        echo audio-volume-high-symbolic
    elif [ "$1" -ge 25 ]; then
        echo audio-volume-medium-symbolic
    else
        echo audio-volume-low-symbolic
    fi
}

case "${1:-}" in
    volume-up)
        # Raising the volume also unmutes, like GNOME. The mute flag survives
        # plain set-volume, and a muted sink with a moving volume bar reads as
        # working audio.
        wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
        wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
        v=$(vol); osd "Volume ${v}%" "$v" "$(vol_icon "$v")"; volume_feedback
        ;;
    volume-down)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
        v=$(vol)
        if muted; then
            osd "Muted ${v}%" "$v" audio-volume-muted-symbolic
        else
            osd "Volume ${v}%" "$v" "$(vol_icon "$v")"; volume_feedback
        fi
        ;;
    volume-mute)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        v=$(vol)
        if muted; then
            osd "Muted" 0 audio-volume-muted-symbolic
        else
            osd "Volume ${v}%" "$v" "$(vol_icon "$v")"; volume_feedback
        fi
        ;;
    mic-mute)
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
            osd "Microphone muted" 0 microphone-sensitivity-muted-symbolic
        else
            osd "Microphone on" 100 microphone-sensitivity-high-symbolic
        fi
        ;;
    brightness-up)
        brightnessctl -q set 5%+
        b=$(brightnessctl -m | awk -F, '{print substr($4, 1, length($4)-1)}')
        osd "Brightness ${b}%" "$b" display-brightness-symbolic
        ;;
    brightness-down)
        brightnessctl -q set 5%-
        b=$(brightnessctl -m | awk -F, '{print substr($4, 1, length($4)-1)}')
        osd "Brightness ${b}%" "$b" display-brightness-symbolic
        ;;
    *)
        echo "usage: niri-osd {volume-up|volume-down|volume-mute|mic-mute|brightness-up|brightness-down}" >&2
        exit 1
        ;;
esac
