# ~/.zshrc — interactive zsh config (migrated from bash 2026-06-27)
# Switched from bash because atuin's enter_accept leaked "__atuin_accept__:"
# in plain bash (no native accept-line). zsh's ZLE supports it natively.

# --- PATH (mirrors ~/.zprofile / old ~/.bashrc) -----------------------------
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"

# --- Homebrew ---------------------------------------------------------------
[[ -x /home/linuxbrew/.linuxbrew/bin/brew ]] && \
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# --- oh-my-zsh (plugins/completions only; starship owns the prompt) ---------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""          # empty: let starship draw the prompt instead of an omz theme
plugins=(git)
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

export EDITOR=emacs

# --- fixterm: recover a terminal left in mouse-reporting / raw mode ----------
# A TUI (e.g. Claude Code on the VPS) killed by a dropped ssh link when the
# laptop sleeps leaves the terminal spewing mouse escapes (64;10;6M ...) and
# swallowing input. Disable mouse + bracketed-paste modes, sane the tty, reinit.
alias fixterm='printf "\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1015l\e[?2004l"; stty sane; reset'

# --- ssh clipboard bridge ----------------------------------------------------
# Ptyxis/VTE drops OSC 52 (gitlab.gnome.org/GNOME/vte/-/issues/2495), so
# clipboard writes from remote sessions (e.g. Claude Code /copy on the VPS)
# never reach the local clipboard. osc52-filter passes the stream through
# untouched and mirrors any OSC 52 payload into the Wayland clipboard.
ssh() {
    if [[ -t 0 && -t 1 && -n ${WAYLAND_DISPLAY-} ]] && (( $+commands[osc52-filter] )); then
        command ssh "$@" | osc52-filter
        return ${pipestatus[1]}
    fi
    command ssh "$@"
}

# --- mosh: roaming-proof twins of the ssh workflow ---------------------------
# mosh keeps the session alive through laptop sleep / WiFi drops / IP changes
# (UDP state sync + local echo), so no `Enter ~ .` + fixterm + re-pick dance.
# It runs over the tailnet (vps-ts): the OCI security list blocks mosh's UDP
# 60000-61000 on the public IP, but tailscale0 carries it fine.
#   mosh claude|codex [label]  ->  fresh agent tmux session (like `ssh claude`)
#   mosh pick / bare `mosh`    ->  fzf session picker      (like `ssh pick`)
#   anything else              ->  real mosh (e.g. `mosh vps-ts` = plain shell)
# NB: mosh bootstraps via `ssh` the binary (not the wrapper below), and Ptyxis
# drops OSC 52 either way, so /copy from the VPS still can't reach the local
# clipboard under mosh; keep using Shift+drag + Ctrl+Shift+C.
mosh() {
    local agent=/home/ubuntu/.local/bin/agent
    case "${1-}" in
        claude|codex) command mosh vps-ts -- "$agent" new "$@" ;;
        pick|'')      command mosh vps-ts -- "$agent" pick ;;
        *)            command mosh "$@" ;;
    esac
}

# --- Prompt -----------------------------------------------------------------
command -v starship >/dev/null && eval "$(starship init zsh)"

# --- atuin shell history (native zsh accept; no ble.sh hack needed) ---------
command -v atuin >/dev/null && eval "$(atuin init zsh)"

# --- zellij: per-terminal persistent session (survives a desktop/terminal crash)
# Each new terminal opens its own fresh zellij session; if gnome-shell or the
# terminal dies, the session keeps running detached. Reattach with `za` and pick
# it back. Skips: non-interactive shells, tmux (agent sessions), an existing
# zellij, and VS Code / Emacs embedded shells. Kill switch: `touch ~/.no-zellij`
# (works even over `ssh host 'touch ~/.no-zellij'` since that is non-interactive).
if [[ -o interactive ]] \
     && [[ -z "$ZELLIJ" && -z "$TMUX" ]] \
     && [[ "$TERM_PROGRAM" != "vscode" && -z "$INSIDE_EMACS" ]] \
     && [[ ! -e "$HOME/.no-zellij" ]] \
     && command -v zellij >/dev/null 2>&1; then
    # Only close the terminal if zellij ran cleanly; if it fails to start,
    # fall through to a normal shell so a broken zellij can never lock you out.
    if zellij; then exit; fi
fi
alias za='zellij attach'

# kimi-code
export PATH="/var/home/ashahid/.kimi-code/bin:$PATH"
